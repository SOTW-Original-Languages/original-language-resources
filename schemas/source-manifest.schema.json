{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOTW source manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "title",
    "edition",
    "origin_url",
    "original_sha256",
    "rights_status",
    "publication_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "origin_url": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "responsible_creators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rights_status": {
      "enum": [
        "unverified",
        "verified",
        "restricted",
        "disputed"
      ]
    },
    "rights_evidence_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publication_status": {
      "enum": [
        "not_ingested",
        "research",
        "validated",
        "approved_public",
        "excluded"
      ]
    },
    "release_decision_evidence": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
