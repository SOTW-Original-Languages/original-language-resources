        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "chapter",
            "verse",
            "verse_text_present"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z0-9]{3,8}\\.[1-9][0-9]*\\.[1-9][0-9]*$"
            },
            "chapter": {
              "type": "integer",
              "minimum": 1
            },
            "verse": {
              "type": "integer",
              "minimum": 1
            },
            "verse_text_present": {
              "const": false
            }
          }
        }
      }
    }
  },
